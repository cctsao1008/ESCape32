    {"id": "neutral", "type": "start", "label": "Neutral / Stopped", "sublabel": "step=0 · bridge stopped/coast/brake", "lane": "command", "col": 0},
    {"id": "throttle", "type": "decision", "label": "Valid throttle", "sublabel": "DShot decode updates throt", "lane": "command", "col": 1},
