  "cards": [
    {
      "dot": "emerald",
      "title": "v1.6 startup constraints",
      "items": [
        "SINE_RANGE=0 disables the sine-startup range for the E61 build.",
        "Initial commanded duty is bounded by DUTY_MIN=14 and DUTY_SPUP=20.",
        "DUTY_RATE=15 limits duty slew; DUTY_RAMP=70 raises the ceiling with ERPM."
      ]
    },
    {
      "dot": "violet",
      "title": "BEMF synchronization",
      "items": [
        "iftim_isr() filters zero-cross intervals and increments sync up to six.",
        "TIM2 overflow clears sync and marks BEMF timing invalid.",
        "Commutation delay is derived from the filtered interval and cfg.timing."
      ]
    }
  ]
